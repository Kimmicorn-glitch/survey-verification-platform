<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <notes>Test dependencies only in test scope</notes>
        <packageUrl>pkg:maven/org.junit.jupiter@.*</packageUrl>
        <cve>CVE-.*</cve>
    </suppress>
    <suppress>
        <notes>H2 database is test-only</notes>
        <packageUrl>pkg:maven/com.h2database@.*</packageUrl>
        <cve>CVE-.*</cve>
    </suppress>
    <suppress>
        <notes>Testcontainers is test-only</notes>
        <packageUrl>pkg:maven/org.testcontainers@.*</packageUrl>
        <cve>CVE-.*</cve>
    </suppress>
</suppressions>
