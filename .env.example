# =============================================================================
# Survey Verification Platform - Environment Configuration
# BackOffice Pro (Pty) Ltd
# =============================================================================

# ----------------------------------
# Application
# ----------------------------------
NODE_ENV=development
APP_NAME=survey-verification-platform
APP_VERSION=1.0.0
APP_PORT=3000

# ----------------------------------
# Database (PostgreSQL)
# ----------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=survey_verification
DB_USERNAME=svp_admin
DB_PASSWORD=change_me_in_production
DB_SSL_MODE=require
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# ----------------------------------
# Authentication
# ----------------------------------
JWT_SECRET=change_me_to_a_secure_random_string
JWT_EXPIRATION=900000
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string
JWT_REFRESH_EXPIRATION=604800000

OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

OAUTH2_MICROSOFT_CLIENT_ID=
OAUTH2_MICROSOFT_CLIENT_SECRET=
OAUTH2_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback/microsoft

# ----------------------------------
# AI Engine (Rust)
# ----------------------------------
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8081
AI_ENGINE_API_KEY=change_me_ai_engine_key

FRAUD_DETECTION_THRESHOLD=0.75
TRUST_SCORE_WEIGHT=0.6
GEO_VALIDATION_ENABLED=true

# ----------------------------------
# Blockchain
# ----------------------------------
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_WS_URL=wss://sepolia.infura.io/ws/v3/YOUR_INFURA_KEY
CONTRACT_PRIVATE_KEY=change_me_contract_private_key

SURVEY_NFT_CONTRACT_ADDRESS=
VERIFICATION_REGISTRY_ADDRESS=
TRUST_SCORE_ORACLE_ADDRESS=

WALLET_CONNECT_PROJECT_ID=
ALCHEMY_API_KEY=

# ----------------------------------
# Storage
# ----------------------------------
AWS_REGION=af-south-1
AWS_S3_BUCKET=svp-production-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----------------------------------
# Redis
# ----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ----------------------------------
# Email / Notifications
# ----------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
EMAIL_FROM=noreply@backofficepro.com

# ----------------------------------
# Monitoring
# ----------------------------------
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=change_me_grafana
LOKI_ENDPOINT=http://localhost:3100
TEMPO_ENDPOINT=http://localhost:3200

# ----------------------------------
# Logging
# ----------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ----------------------------------
# CORS
# ----------------------------------
CORS_ORIGINS=http://localhost:3000,https://app.backofficepro.com
CORS_ALLOW_CREDENTIALS=true

# ----------------------------------
# Rate Limiting
# ----------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------
# Encryption
# ----------------------------------
ENCRYPTION_KEY=change_me_32_byte_encryption_key
ENCRYPTION_IV_LENGTH=16
