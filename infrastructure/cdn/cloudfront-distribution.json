{
  "Comment": "Survey Verification Platform - CloudFront Distribution",
  "CallerReference": "svp-cdn-2024",
  "Aliases": {
    "Quantity": 2,
    "Items": [
      "surveyverification.com",
      "www.surveyverification.com"
    ]
  },
  "DefaultRootObject": "",
  "Origins": {
    "Quantity": 2,
    "Items": [
      {
        "Id": "ALB-Backend",
        "DomainName": "alb-svp-backend.svp-internal.com",
        "OriginPath": "",
        "CustomHeaders": {
          "Quantity": 0
        },
        "CustomOriginConfig": {
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "https-only",
          "OriginSslProtocols": {
            "Quantity": 1,
            "Items": ["TLSv1.2"]
          },
          "OriginReadTimeout": 30,
          "OriginKeepaliveTimeout": 5
        },
        "ConnectionAttempts": 3,
        "ConnectionTimeout": 10,
        "OriginShield": {
          "Enabled": false
        }
      },
      {
        "Id": "S3-Frontend-Static",
        "DomainName": "svp-frontend-static.s3.af-south-1.amazonaws.com",
        "OriginPath": "",
        "CustomHeaders": {
          "Quantity": 1,
          "Items": [
            {
              "Name": "Origin-Authorization",
              "Value": "${CLOUDFRONT_ORIGIN_ACCESS_KEY}"
            }
          ]
        },
        "S3OriginConfig": {
          "OriginAccessIdentity": "origin-access-identity/cloudfront/${CLOUDFRONT_OAI_ID}"
        },
        "ConnectionAttempts": 3,
        "ConnectionTimeout": 10
      }
    ]
  },
  "DefaultCacheBehavior": {
    "TargetOriginId": "S3-Frontend-Static",
    "ViewerProtocolPolicy": "redirect-to-https",
    "AllowedMethods": {
      "Quantity": 2,
      "Items": ["GET", "HEAD"],
      "CachedMethods": {
        "Quantity": 2,
        "Items": ["GET", "HEAD"]
      }
    },
    "SmoothStreaming": false,
    "Compress": true,
    "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
    "OriginRequestPolicyId": "88a5eaf4-2fd4-4709-b370-b4c650ea3fcf",
    "TrustedSigners": {
      "Enabled": false,
      "Quantity": 0
    },
    "TrustedKeyGroups": {
      "Enabled": false,
      "Quantity": 0
    },
    "SmoothStreaming": false,
    "DefaultTTL": 86400,
    "MaxTTL": 31536000,
    "MinTTL": 0
  },
  "CacheBehaviors": {
    "Quantity": 3,
    "Items": [
      {
        "PathPattern": "/_next/static/*",
        "TargetOriginId": "S3-Frontend-Static",
        "ViewerProtocolPolicy": "redirect-to-https",
        "AllowedMethods": {
          "Quantity": 2,
          "Items": ["GET", "HEAD"],
          "CachedMethods": {
            "Quantity": 2,
            "Items": ["GET", "HEAD"]
          }
        },
        "Compress": true,
        "DefaultTTL": 31536000,
        "MaxTTL": 31536000,
        "MinTTL": 0,
        "TrustedSigners": { "Enabled": false, "Quantity": 0 },
        "TrustedKeyGroups": { "Enabled": false, "Quantity": 0 }
      },
      {
        "PathPattern": "/api/*",
        "TargetOriginId": "ALB-Backend",
        "ViewerProtocolPolicy": "redirect-to-https",
        "AllowedMethods": {
          "Quantity": 7,
          "Items": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"],
          "CachedMethods": {
            "Quantity": 2,
            "Items": ["GET", "HEAD"]
          }
        },
        "Compress": true,
        "DefaultTTL": 0,
        "MaxTTL": 0,
        "MinTTL": 0,
        "TrustedSigners": { "Enabled": false, "Quantity": 0 },
        "TrustedKeyGroups": { "Enabled": false, "Quantity": 0 }
      },
      {
        "PathPattern": "/ai/*",
        "TargetOriginId": "ALB-Backend",
        "ViewerProtocolPolicy": "redirect-to-https",
        "AllowedMethods": {
          "Quantity": 7,
          "Items": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"],
          "CachedMethods": {
            "Quantity": 2,
            "Items": ["GET", "HEAD"]
          }
        },
        "Compress": true,
        "DefaultTTL": 0,
        "MaxTTL": 0,
        "MinTTL": 0,
        "TrustedSigners": { "Enabled": false, "Quantity": 0 },
        "TrustedKeyGroups": { "Enabled": false, "Quantity": 0 }
      }
    ]
  },
  "CustomErrorResponses": {
    "Quantity": 2,
    "Items": [
      {
        "ErrorCode": 404,
        "ResponsePagePath": "/404.html",
        "ResponseCode": "404",
        "ErrorCachingMinTTL": 300
      },
      {
        "ErrorCode": 500,
        "ResponsePagePath": "/500.html",
        "ResponseCode": "500",
        "ErrorCachingMinTTL": 10
      }
    ]
  },
  "HttpVersion": "http2and3",
  "IsIPV6Enabled": true,
  "Logging": {
    "Enabled": true,
    "Bucket": "svp-cdn-logs.s3.af-south-1.amazonaws.com",
    "Prefix": "cloudfront/",
    "IncludeCookies": false
  },
  "PriceClass": "PriceClass_100",
  "ViewerCertificate": {
    "CloudFrontDefaultCertificate": false,
    "ACMCertificateArn": "arn:aws:acm:af-south-1:${AWS_ACCOUNT_ID}:certificate/${CERTIFICATE_ID}",
    "SSLSupportMethod": "sni-only",
    "MinimumProtocolVersion": "TLSv1.2_2021"
  },
  "WebACLId": "arn:aws:wafv2:af-south-1:${AWS_ACCOUNT_ID}:regional/webacl/svp-waf/${WAF_ACL_ID}",
  "Restrictions": {
    "GeoRestriction": {
      "RestrictionType": "none",
      "Quantity": 0
    }
  }
}
