{
  "name": "survey-verification-platform-blockchain",
  "version": "1.0.0",
  "description": "Smart contracts for the Survey Verification Platform by BackOffice Pro",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:gas": "REPORT_GAS=true npx hardhat test",
    "coverage": "npx hardhat coverage",
    "deploy:sepolia": "npx hardhat run scripts/deploy.ts --network sepolia",
    "deploy:polygon": "npx hardhat run scripts/deploy.ts --network polygon",
    "deploy:mainnet": "npx hardhat run scripts/deploy.ts --network mainnet",
    "deploy:polygon-amoy": "npx hardhat run scripts/deploy.ts --network polygonAmoy",
    "verify:sepolia": "npx hardhat run scripts/verify.ts --network sepolia",
    "verify:polygon": "npx hardhat run scripts/verify.ts --network polygon",
    "verify:mainnet": "npx hardhat run scripts/verify.ts --network mainnet",
    "clean": "npx hardhat clean",
    "size": "npx hardhat size-contracts",
    "lint:sol": "npx solhint 'contracts/**/*.sol'"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-verify": "^2.0.10",
    "@typechain/hardhat": "^9.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "hardhat": "^3.13.0",
    "hardhat-gas-reporter": "^2.2.2",
    "hardhat-contract-sizer": "^2.10.0",
    "solidity-coverage": "^0.8.14",
    "chai": "^4.5.0",
    "ethers": "^6.13.4",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "dotenv": "^16.4.7",
    "solhint": "^5.0.4"
  }
}
