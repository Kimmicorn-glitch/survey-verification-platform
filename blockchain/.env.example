# RPC Endpoints
ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ETHEREUM_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Private Keys (never commit real keys)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Etherscan / Block Explorer API Keys
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY

# IPFS / Arweave
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
ARWEAVE_TX_ID=your_arweave_transaction_id

# Gas Reporter
REPORT_GAS=false
COINMARKETCAP_API_KEY=YOUR_CMC_API_KEY

# Contract Configuration
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS
MINTER_ADDRESS=0xYOUR_MINTER_ADDRESS
